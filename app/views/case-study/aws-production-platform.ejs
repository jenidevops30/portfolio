<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="AWS Production Platform case study by Jeni Patel.">
  <title><%= typeof title !== 'undefined' ? title : 'AWS Production Platform' %> | Jeni Patel</title>
  <link rel="stylesheet" href="/css/style.css">
  <link
    rel="stylesheet"
    href="/css/case-study.css"
  />
</head>
<body>

<header class="site-header">
  <nav class="container navigation">
    <a href="/" class="logo">Jeni Patel</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/#projects">Projects</a>
      <a href="/#experience">Experience</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
</header>

<main class="case-study">

  <section class="case-hero">
    <span class="eyebrow">AWS PRODUCTION PLATFORM</span>

    <h1>AWS Production Platform</h1>

    <p class="case-status">
      ● BUILDING
    </p>

    <p class="case-description">
      A production-style AWS platform built to demonstrate
      infrastructure design, provisioning, security,
      troubleshooting, observability, and operational thinking.
    </p>
  </section>


  <section class="progress-section">

    <div class="section-heading">
      <span>INFRASTRUCTURE PROGRESS</span>
    </div>

    <div class="progress-grid">

      <div class="progress-item completed">
        <span>✓</span>
        <span>VPC</span>
      </div>

      <div class="progress-item completed">
        <span>✓</span>
        <span>Multi-AZ Subnets</span>
      </div>

      <div class="progress-item completed">
        <span>✓</span>
        <span>Route Tables</span>
      </div>

      <div class="progress-item completed">
        <span>✓</span>
        <span>Internet Gateway</span>
      </div>

      <div class="progress-item completed">
        <span>✓</span>
        <span>Security Groups</span>
      </div>

      <div class="progress-item completed">
        <span>✓</span>
        <span>EC2</span>
      </div>

      <div class="progress-item planned">
        <span>○</span>
        <span>ALB</span>
      </div>

      <div class="progress-item planned">
        <span>○</span>
        <span>RDS</span>
      </div>

      <div class="progress-item planned">
        <span>○</span>
        <span>CloudWatch</span>
      </div>

      <div class="progress-item planned">
        <span>○</span>
        <span>Failure Testing</span>
      </div>

    </div>
  </section>


  <section class="architecture-section">

    <div class="section-heading">
      <span>ARCHITECTURE</span>
    </div>

    <div class="architecture-card">

      <div class="architecture-node">
        INTERNET
      </div>

      <div class="architecture-arrow">↓</div>

      <div class="architecture-node">
        INTERNET GATEWAY
      </div>

      <div class="architecture-arrow">↓</div>

      <div class="architecture-node large">
        VPC<br>
        <small>10.0.0.0/16</small>
      </div>

      <div class="architecture-columns">

        <div>
          <strong>us-east-1a</strong>

          <div class="subnet-card">
            Application<br>
            10.0.1.0/24
          </div>

          <div class="subnet-card private">
            Database<br>
            10.0.11.0/24
          </div>
        </div>

        <div>
          <strong>us-east-1b</strong>

          <div class="subnet-card">
            Application<br>
            10.0.2.0/24
          </div>

          <div class="subnet-card private">
            Database<br>
            10.0.12.0/24
          </div>
        </div>

      </div>

    </div>

    <p class="architecture-note">
      Current architecture reflects the infrastructure actually
      provisioned and verified. ALB, RDS, and additional
      production components remain planned.
    </p>

  </section>


  <section class="timeline-section">

    <div class="section-heading">
      <span>ENGINEERING JOURNEY</span>
    </div>

    <% days.forEach(day => { %>

      <article class="day-card <%= day.status %>">

        <div class="day-header">

          <div>
            <span class="day-number">
              DAY <%= String(day.day).padStart(2, "0") %>
            </span>

            <h2><%= day.title %></h2>
          </div>

          <span class="day-status">
            <%= day.label %>
          </span>

        </div>

        <p class="day-summary">
          <%= day.summary %>
        </p>

        <div class="day-sections">

          <% day.sections.forEach(section => { %>

            <div class="day-section">

              <h3>
                <%= section.title %>
              </h3>

              <p>
                <%= section.content %>
              </p>

            </div>

          <% }) %>

        </div>

      </article>

    <% }) %>

  </section>


  <section class="incident-section">

    <div class="section-heading">
      <span>INCIDENT REPORT</span>
    </div>

    <article class="incident-card">

      <div class="incident-meta">
        <span>INCIDENT #001</span>
        <span>LOW</span>
        <span>ACCESS / COMPUTE</span>
      </div>

      <h2>EC2 SSH Authentication Failure</h2>

      <div class="incident-grid">

        <div>
          <h3>Symptom</h3>

          <pre><code>ssh ubuntu@&lt;public-ip&gt;

Permission denied (publickey)</code></pre>
        </div>

        <div>
          <h3>Investigation</h3>

          <ul>
            <li>EC2 was running</li>
            <li>Public IP was assigned</li>
            <li>Application subnet was correct</li>
            <li>TCP/22 was allowed from administrator IP</li>
            <li>Terraform showed <code>key_name = null</code></li>
          </ul>
        </div>

      </div>

      <div class="root-cause">

        <span>ROOT CAUSE</span>

        <p>
          The EC2 instance was provisioned without an
          EC2 key pair, preventing SSH authentication.
        </p>

      </div>

      <div class="remediation">

        <h3>Remediation</h3>

        <pre><code>key_name = var.key_name</code></pre>

        <p>
          The Terraform configuration is being updated to
          explicitly associate the EC2 instance with the
          AWS key pair.
        </p>

      </div>

    </article>

  </section>


  <section class="evidence-section">

    <div class="section-heading">
      <span>EVIDENCE REGISTER</span>
    </div>

    <div class="evidence-grid">

      <div class="evidence-card">
        <strong>E001</strong>
        <span>Terraform Network Plan</span>
      </div>

      <div class="evidence-card">
        <strong>E002</strong>
        <span>VPC Verification</span>
      </div>

      <div class="evidence-card">
        <strong>E003</strong>
        <span>Subnet Verification</span>
      </div>

      <div class="evidence-card">
        <strong>E004</strong>
        <span>Route Table Verification</span>
      </div>

      <div class="evidence-card">
        <strong>E005</strong>
        <span>Security Group Verification</span>
      </div>

      <div class="evidence-card">
        <strong>E006</strong>
        <span>EC2 Verification</span>
      </div>

      <div class="evidence-card">
        <strong>E007</strong>
        <span>SSH Incident</span>
      </div>

    </div>

  </section>


  <section class="lesson-section">

    <div class="section-heading">
      <span>ENGINEERING LESSON</span>
    </div>

    <blockquote>
      Infrastructure provisioning is not complete when
      Terraform reports apply successful. It is complete
      only after the resulting infrastructure has been
      operationally verified.
    </blockquote>

  </section>

</main>

<footer>
  <div class="container">
    <p>© 2026 Jeni Patel</p>
    <p>DevOps • AWS • Infrastructure • Reliability</p>
  </div>
</footer>

</body>
</html>