<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="DevOps projects by Jeni Patel — AWS infrastructure, automation, and production operations.">
  <title>Projects | Jeni Patel</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/case-study.css">
</head>
<body>

<header class="site-header">
  <nav class="container navigation">
    <a href="/" class="logo">Jeni Patel</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/projects" style="text-decoration: underline;">Projects</a>
      <a href="/#about">About</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
</header>

<main class="case-study">

  <!-- PAGE HEADER -->
  <section class="case-hero">
    <span class="eyebrow">PORTFOLIO</span>
    <h1>Projects</h1>
    <p class="case-description">
      Production-style engineering projects demonstrating AWS infrastructure,
      automation, operational reliability, and cost engineering.
      Each project is built with real tooling and verified with evidence.
    </p>
  </section>

  <!-- SUMMARY ROW -->
  <div class="section-heading">
    <span><%= projects.length %> PROJECTS</span>
    <span style="font-weight:400; font-size:12px;">
      <%= projects.filter(p => p.status === 'completed').length %> completed &nbsp;·&nbsp;
      <%= projects.filter(p => p.status === 'in-progress').length %> in progress &nbsp;·&nbsp;
      <%= projects.filter(p => p.status === 'planned').length %> planned
    </span>
  </div>

  <!-- PROJECT CARDS -->
  <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 30px;">

    <% projects.forEach((project, i) => { %>

    <article class="day-card <%= project.status %>" style="padding: 36px;">

      <div class="day-header">
        <div>
          <span class="day-number"><%= String(i + 1).padStart(2, '0') %> &nbsp;·&nbsp; <%= project.label %></span>
          <h2 style="margin: 10px 0 0; font-size: 28px;"><%= project.title %></h2>
        </div>
        <span class="day-status"><%= project.statusLabel %></span>
      </div>

      <p class="day-summary" style="margin: 20px 0;"><%= project.description %></p>

      <!-- Tech tags -->
      <div class="tags" style="margin: 0 0 20px;">
        <% project.technologies.forEach(tech => { %>
          <span><%= tech %></span>
        <% }) %>
      </div>

      <!-- Progress bar for in-progress projects -->
      <% if (project.days) { %>
      <div style="margin-bottom: 20px;">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; margin-bottom: 8px;">
          PROGRESS &nbsp;·&nbsp; DAY <%= project.days.completed %> OF <%= project.days.total %>
        </div>
        <div style="display: flex; gap: 4px;">
          <% for (let d = 1; d <= project.days.total; d++) { %>
          <div style="
            height: 4px;
            flex: 1;
            background: <%= d <= project.days.completed ? '#111' : '#ddd' %>;
          "></div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Link -->
      <% if (project.link) { %>
      <div style="border-top: 1px solid #eee; padding-top: 20px;">
        <a href="<%= project.link %>" style="font-size: 13px; font-weight: 700; text-decoration: none; border-bottom: 1px solid #111; padding-bottom: 2px;">
          View Case Study →
        </a>
      </div>
      <% } else if (project.status === 'planned') { %>
      <div style="border-top: 1px solid #eee; padding-top: 20px;">
        <span style="font-size: 13px; color: #999; font-weight: 600;">Coming soon</span>
      </div>
      <% } %>

    </article>

    <% }) %>

  </div>

  <!-- BACK TO HOME -->
  <div style="margin-top: 80px; border-top: 1px solid #eee; padding-top: 40px;">
    <a href="/" style="font-size: 13px; font-weight: 700; text-decoration: none; border-bottom: 1px solid #111; padding-bottom: 2px;">
      ← Back to Home
    </a>
  </div>

</main>

<footer>
  <div class="container">
    <p>Jeni Patel — DevOps Engineer</p>
    <p>Built with Node.js &amp; deployed on AWS</p>
  </div>
</footer>

</body>
</html>
