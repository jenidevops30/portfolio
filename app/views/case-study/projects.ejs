<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="DevOps projects by Jeni Patel — AWS infrastructure, automation, and production operations.">
  <title>Projects | Jeni Patel</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/case-study.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.ico">
</head>
<body>

<header class="site-header">
  <nav class="container navigation">
    <a href="/" class="logo">Jeni Patel</a>
    <div class="nav-links">
      <a href="/#about">About</a>
      <a href="/#skills">Skills</a>
      <a href="/projects" style="text-decoration: underline; font-weight: 700;">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/#approach">Approach</a>
      <a href="/#experience">Experience</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
</header>

<main class="case-study">

  <!-- PAGE HEADER -->
  <section class="case-hero">
    <span class="eyebrow">PORTFOLIO</span>
    <h1>Projects</h1>
    <p class="case-description">
      Production-style engineering projects demonstrating AWS infrastructure,
      automation, operational reliability, and cost engineering.
      Each project is built with real tooling and verified with evidence.
    </p>
  </section>

  <%
    const completedCount = projects.filter(function(p) { return p.status === 'completed'; }).length;
    const inProgressCount = projects.filter(function(p) { return p.status === 'in-progress'; }).length;
    const plannedCount = projects.filter(function(p) { return p.status === 'planned'; }).length;
  %>

  <!-- SUMMARY ROW -->
  <div class="section-heading">
    <span><%= projects.length %> PROJECTS</span>
    <span style="font-weight:400; font-size:12px;">
      <%= completedCount %> completed &nbsp;&middot;&nbsp;
      <%= inProgressCount %> in progress &nbsp;&middot;&nbsp;
      <%= plannedCount %> planned
    </span>
  </div>

  <!-- PROJECT CARDS -->
  <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 30px;">

    <% projects.forEach(function(project, i) { %>

    <article class="day-card <%= project.status %>" style="padding: 36px;">

      <div class="day-header">
        <div>
          <span class="day-number"><%= String(i + 1).padStart(2, '0') %> &nbsp;&middot;&nbsp; <%= project.label %></span>
          <h2 style="margin: 10px 0 0; font-size: 28px;"><%= project.title %></h2>
        </div>
        <span class="day-status"><%= project.statusLabel %></span>
      </div>

      <p class="day-summary" style="margin: 20px 0;"><%= project.description %></p>

      <!-- Tech tags -->
      <% if (project.technologies && project.technologies.length) { %>
      <div class="tags" style="margin: 0 0 20px;">
        <% project.technologies.forEach(function(tech) { %>
          <span><%= tech %></span>
        <% }); %>
      </div>
      <% } %>

      <!-- Progress bar for in-progress projects -->
      <% if (project.days && project.days.total) { %>
      <div style="margin-bottom: 20px;">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; margin-bottom: 8px;">
          PROGRESS &nbsp;&middot;&nbsp; DAY <%= project.days.completed %> OF <%= project.days.total %>
        </div>
        <div style="display: flex; gap: 4px;">
          <% for (let d = 1; d <= project.days.total; d++) { 
               const isFilled = (d <= project.days.completed);
          %>
          <div style="height: 4px; flex: 1; background: <%= isFilled ? '#3ec9a8' : '#e2e8f0' %>; border-radius: 2px;"></div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- Link -->
      <% if (project.link) { %>
      <div style="border-top: 1px solid #eee; padding-top: 20px;">
        <a href="<%= project.link %>" style="font-size: 13px; font-weight: 700; text-decoration: none; color: #0f766e; border-bottom: 2px solid #3ec9a8; padding-bottom: 2px;">
          View Case Study &rarr;
        </a>
      </div>
      <% } else if (project.status === 'planned') { %>
      <div style="border-top: 1px solid #eee; padding-top: 20px;">
        <span style="font-size: 13px; color: #999; font-weight: 600;">Coming soon</span>
      </div>
      <% } else { %>
      <div style="border-top: 1px solid #eee; padding-top: 20px;">
        <span style="font-size: 13px; color: #999; font-weight: 600;">Case study coming soon</span>
      </div>
      <% } %>

    </article>

    <% }); %>

  </div>

  <!-- BACK TO HOME -->
  <div style="margin-top: 80px; border-top: 1px solid #eee; padding-top: 40px;">
    <a href="/" style="font-size: 13px; font-weight: 700; text-decoration: none; color: #0f766e; border-bottom: 2px solid #3ec9a8; padding-bottom: 2px;">
      &larr; Back to Home
    </a>
  </div>

</main>

<footer>
  <div class="container">
    <p>&copy; 2026 Jeni Patel</p>
    <p>DevOps &bull; AWS &bull; Infrastructure &bull; Reliability</p>
  </div>
</footer>

</body>
</html>
