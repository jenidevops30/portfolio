{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000"],
      "numberOfRuns": 1,
      "staticDistDir": "./frontend/dist"
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.80 }],
        "categories:best-practices": ["error", { "minScore": 0.80 }],
        "categories:seo": ["error", { "minScore": 0.85 }],
        "categories:pwa": ["warn", { "minScore": 0.30 }],
        "color-contrast": ["warn", { "minScore": 0.5 }],
        "installable-manifest": ["off"],
        "splash-screen": ["off"],
        "themed-omnibox": ["off"],
        "maskable-icon": ["off"],
        "landmark-one-main": ["warn"],
        "identical-links-same-purpose": ["warn"],
        "unsized-images": ["warn", { "minScore": 0.5 }],
        "unused-javascript": ["warn"],
        "uses-responsive-images": ["warn"]
      }
    }
  }
}
